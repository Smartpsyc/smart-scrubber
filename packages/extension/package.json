  },
  "license": "Apache-2.0",
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/heb": "^1.0.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  }
}
